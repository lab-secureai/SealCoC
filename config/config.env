# Reproducibility-pinned versions. Edit only if you intentionally change the paper environment.
WSL_DISTRO=Ubuntu-24.04
FABRIC_VERSION=2.5.16
FABRIC_CA_VERSION=1.5.22
FABRIC_CHANNEL=sealchannel
FABRIC_CC_NAME=sealcc
FABRIC_CC_VERSION=1.0
FABRIC_CC_SEQUENCE=1

CIRCOM_VERSION=2.2.3
SNARKJS_VERSION=0.7.6
CIRCOMLIB_VERSION=2.0.5
PTAU_POWER=18
SNARK_REPS=20
SNARK_SIZES=64,128,256,512,1024,2048,4096
FABRIC_CIRCUIT_SIZE=256
FABRIC_TX_REPS=30
FABRIC_CONCURRENCY=8
MASK_BYTE=42
MAX_MASK_RATIO=0.50

# 1 = also run local EVM Groth16 verifier benchmark after Fabric.
RUN_EVM=1
# 1 = retain Fabric network after completion; 0 = stop it at the end.
KEEP_FABRIC_UP=0
FABRIC_THROUGHPUT_TX=32

# Paper-suite settings ()
SNARK_MASK_RATIO_REPS=10
FABRIC_PAPER_VERIFY_REPS=20
FABRIC_PAPER_SUBMIT_REPS=10
FABRIC_PAPER_FLOW_REPS=10
FABRIC_PAPER_THROUGHPUT_TX=32
FABRIC_PAPER_CONCURRENCIES="1 2 4 8 16"
FABRIC_PAPER_E2E_REPS=3
FABRIC_PAPER_WAN_REPS=3
DATASET_REPS=15
FORENSIC_MAX_BYTES=536870912
RUN_LITERATURE_BASELINES=1

# final-validation settings (). These intentionally trade runtime for reviewer-grade statistics.
FINAL_VERIFY_REPS=30
FINAL_VERIFY_WARMUP=5
FINAL_SUBMIT_REPS=15
FINAL_SUBMIT_WARMUP=2
FINAL_FLOW_REPS=20
FINAL_FLOW_WARMUP=3
FINAL_THROUGHPUT_TX=40
FINAL_THROUGHPUT_RUNS=5
FINAL_CONCURRENCIES="1 2 4 8 16"
FINAL_WAN_REPS=10
FINAL_WAN_WARMUP=1
FINAL_E2E_REPS=10
FINAL_TCH_REPS=20
FINAL_NETWORK_DATASET_MAX_BYTES=134217728
FINAL_BINARY_IMAGE_MIB=128
